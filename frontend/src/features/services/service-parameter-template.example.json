      "minValue": null,
      "maxValue": null,
      "unit": ""
    },
    {
      "key": "turnaround",
      "label": "Turnaround",
      "type": "choice",
      "required": true,
      "defaultValue": "Standard (3–5 business days)",
      "options": [
        "Standard (3–5 business days)",
        "Express (1–2 business days)",
        "Same day (subject to approval)"
