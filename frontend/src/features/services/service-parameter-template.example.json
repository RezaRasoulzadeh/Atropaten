        "170gsm matte coated",
        "250gsm matte coated",
        "300gsm matte coated",
        "350gsm silk coated",
        "300gsm recycled"
      ],
      "minValue": null,
      "maxValue": null,
      "unit": ""
    },
    {
      "key": "size",
      "label": "Size",
      "type": "choice",
      "required": true,
      "defaultValue": "A4 (210 × 297 mm)",
      "options": [
        "A6 (105 × 148 mm)",
        "A5 (148 × 210 mm)",
        "A4 (210 × 297 mm)",
        "A3 (297 × 420 mm)",
